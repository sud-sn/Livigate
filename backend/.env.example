# Copy to backend/.env for local overrides. Secrets are injected from the vault in shared environments —
# never commit real values. Every setting is prefixed LEVIGATE_ (see levigate/config.py).

LEVIGATE_ENV=dev                                  # dev | demo | test | prod (demo sign-in only outside prod)
LEVIGATE_TENANT_ID=demo
LEVIGATE_PHARMACY_NAME="Maple Street Compounding (demo)"
LEVIGATE_TIMEZONE=America/Chicago

LEVIGATE_APP_DB_URL=sqlite+aiosqlite:///./data/levigate_app.db   # prod: postgresql+asyncpg://...
LEVIGATE_WAREHOUSE_URL=sqlite:///./data/demo_warehouse.db         # prod: snowflake://... (read-only role)
LEVIGATE_CONNECTOR_ALLOWED_HOSTS=[]               # JSON list of hosts the connector may reach

LEVIGATE_SESSION_IDLE_MINUTES=15
LEVIGATE_SESSION_COOKIE_SECURE=false              # must be true in prod
LEVIGATE_ALLOWED_ORIGINS=["http://localhost:5173"]

LEVIGATE_SYNC_ENABLED=true
LEVIGATE_SYNC_INTERVAL_MINUTES=15

LEVIGATE_AI_PROVIDER=offline                      # offline | azure_openai (needs an active BAA in the vendor register)
# LEVIGATE_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# LEVIGATE_AZURE_OPENAI_DEPLOYMENT=<deployment>
# LEVIGATE_AZURE_OPENAI_API_KEY=                  # from Key Vault, never committed
LEVIGATE_AI_DAILY_TOKENS_PER_USER=60000

LEVIGATE_OFFSHORE_PHI_MASKING=true                # C-11
